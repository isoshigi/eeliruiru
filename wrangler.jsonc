{
	"$schema": "https://developers.cloudflare.com/workers/wrangler/configuration-schema.json",
	"name": "eeliruiru",
	"main": "src/worker.ts",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./public",
		"not_found_handling": "single-page-application"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "eeliruiru-db",
			"database_id": "c4f270bc-974b-48f2-9bc4-b8aab1141915",
			"migrations_dir": "migrations"
		}
	],
	"observability": {
		"enabled": true
	}
}