{
  "name": "eeliruiru",
  "version": "1.0.0",
  "description": "60秒でウナギを見極めて炒める、仕分け＋重ね炒りアクションゲーム。",
  "scripts": {
    "dev": "concurrently -k -n frontend,worker -c cyan,magenta \"npm:dev:frontend\" \"npm:dev:worker\"",
    "dev:frontend": "node scripts/build-frontend.mjs --watch",
    "dev:worker": "wrangler dev",
    "clean": "node -e \"require('node:fs').rmSync('public/js',{recursive:true,force:true})\"",
    "predeploy": "npm run build:frontend",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply eeliruiru-db --local",
    "typecheck": "tsc -p tsconfig.backend.json",
    "typecheck:frontend": "tsc -p tsconfig.frontend.json",
    "build:frontend": "node scripts/build-frontend.mjs",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "test": "npm run test:unit && npm run test:workers",
    "test:unit": "vitest run",
    "test:workers": "vitest run -c vitest.workers.config.ts",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "hono": "^4.13.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260905.1",
    "@types/node": "^26.4.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  }
}
